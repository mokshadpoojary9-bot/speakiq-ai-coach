# Copy to .env for local development. Placeholders only - never commit real secrets.
# No paid API keys are required to run SpeakIQ AI Coach locally.

# --- Backend (read by backend/app/config.py) ---
APP_ENV=development
# Comma-separated list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (read by Vite) ---
# VITE_* values are embedded in the public client bundle. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8000
