# Copy to backend/.env for local development. Placeholders only - never commit real secrets.
# Everything here is optional: the defaults work, and no paid API key is needed.

APP_ENV=development
# Comma-separated browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits.
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=300

# Pause detection. Silence is anything this far below the speech level, or within the margin
# of the background noise floor when noise is present. Pauses shorter than the minimum are ignored.
PAUSE_SILENCE_BELOW_SPEECH_DB=25
PAUSE_NOISE_MARGIN_DB=3
PAUSE_MIN_SEC=0.25

# Widest pitch range the tracker may search, in Hz. Lower PITCH_MIN_HZ for exceptionally low voices.
PITCH_MIN_HZ=50
PITCH_MAX_HZ=600

# Local transcription (faster-whisper). Public models: tiny, base, small, medium, large-v3.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to detect the language, or set a code such as en.
WHISPER_LANGUAGE=
# Leave empty to use the default Hugging Face cache directory.
WHISPER_DOWNLOAD_ROOT=

# Hugging Face token. NOT needed for the public models above; leave empty.
# Only set it if you point WHISPER_MODEL at a private or gated repository.
HF_TOKEN=
